generator client {
  provider = "prisma-client-js"
}

datasource postgres {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            Int      @id @default(autoincrement())
  username      String   @unique @postgres.VarChar(50)
  email         String   @unique @postgres.VarChar(100)
  password_hash String
  role          String?  @default("user") @postgres.VarChar(20)
  created_at    DateTime @default(now()) @postgres.Timestamp(0)
}

model university {
  id              Int       @id @default(autoincrement())
  name            String?   @postgres.VarChar(100)
  name_th         String?   @postgres.VarChar(100)
  abbreviation    String?   @postgres.VarChar(50)
  abbreviation_th String?   @postgres.VarChar(50)
  faculties       faculty[]

  @@map("university")
}

model program {
  id                   Int       @id @default(autoincrement())
  faculty_id           Int
  program_code         String    @postgres.VarChar(50)
  program_name_en      String    @postgres.VarChar(255)
  program_name_th      String?   @postgres.VarChar(255)
  program_shortname_en String?   @postgres.VarChar(100)
  program_shortname_th String?   @postgres.VarChar(100)
  program_year         Int
  courses              course[]
  plos                 plo[]
  faculty              faculty   @relation(fields: [faculty_id], references: [id])
  student              student[]

  @@unique([program_code, program_year])
  @@map("program")
}

model faculty {
  id              Int        @id @default(autoincrement())
  university_id   Int
  name            String     @postgres.VarChar(100)
  name_th         String     @postgres.VarChar(100)
  abbreviation    String?    @postgres.VarChar(50)
  abbreviation_th String?    @postgres.VarChar(50)
  university      university @relation(fields: [university_id], references: [id])

  programs        program[]

  @@map("faculty")
}

model course {
  id         Int     @id @default(autoincrement())
  code       String  @postgres.VarChar(50)
  name       String  @postgres.VarChar(255)
  name_th    String  @postgres.VarChar(255)
  program_id Int
  section    Int
  semester   Int     @default(1)
  program    program @relation(fields: [program_id], references: [id])
  clo       clo[]
  assignments Assignment[] 

  @@map("course")
}

model student {
  id                Int       @id @default(autoincrement())
  student_id        String    @unique @postgres.VarChar(20)
  first_name        String    @postgres.VarChar(100)
  last_name         String    @postgres.VarChar(100)
  program_id        Int
  created_at        DateTime? @default(now()) @postgres.Timestamp(6)
  program           program?  @relation(fields: [program_id], references: [id], onUpdate: NoAction)

  @@map("student")
}

model plo {
  id         Int     @id @default(autoincrement())
  code       String  @postgres.VarChar(50)
  program_id Int
  name       String
  engname    String
  program    program @relation(fields: [program_id], references: [id])
  clo_plo_mappings clo_plo_mapping[]

  @@map("plo")
}

model clo {
  id        Int     @id @default(autoincrement())
  code      String  @postgres.VarChar(20)
  name      String  @postgres.VarChar(255)
  name_th   String  @postgres.VarChar(255)
  course_id Int
  course    course  @relation(fields: [course_id], references: [id], onUpdate: NoAction, onDelete: Cascade)
  clo_plo_mappings clo_plo_mapping[]

  @@map("clo")
}

model clo_plo_mapping {
  id        Int      @id @default(autoincrement())
  cloId     Int      @map("clo_id")
  ploId     Int      @map("plo_id")
  weight    Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  clo       clo      @relation(fields: [cloId], references: [id], onDelete: Cascade)
  plo       plo      @relation(fields: [ploId], references: [id], onDelete: Cascade)

  @@unique([cloId, ploId], map: "unique_clo_plo")
  @@map("clo_plo_mapping")
}

model Assignment {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  name        String
  description String?
  maxScore    Decimal  @default(100) @map("max_score") 
  weight      Decimal  @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  course      course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("assignment") // Ensures the table name is lowercase 'assignment' in Postgres
}

