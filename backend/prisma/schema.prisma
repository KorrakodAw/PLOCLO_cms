generator client {
  provider = "prisma-client-js"
}

datasource postgres {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            Int      @id @default(autoincrement())
  username      String   @unique @postgres.VarChar(50)
  email         String   @unique @postgres.VarChar(100)
  password_hash String?
  role          String?  @default("guest")
  created_at    DateTime @default(now()) @postgres.Timestamp(0)

  @@map("users")
}

model University {
  id              Int       @id @default(autoincrement())
  name            String?   @postgres.VarChar(100)
  name_th         String?   @postgres.VarChar(100)
  abbreviation    String?   @postgres.VarChar(50)
  abbreviation_th String?   @postgres.VarChar(50)
  faculties       Faculty[]

  @@map("university")
}

model Program {
  id                   Int       @id @default(autoincrement())
  faculty_id           Int
  program_code         String    @postgres.VarChar(50)
  program_name_en      String    @postgres.VarChar(255)
  program_name_th      String?   @postgres.VarChar(255)
  program_shortname_en String?   @postgres.VarChar(100)
  program_shortname_th String?   @postgres.VarChar(100)
  program_year         Int
  courses              Course[]
  plos                 Plo[]
  student              Student[]
  faculty              Faculty   @relation(fields: [faculty_id], references: [id], onDelete: Cascade)

  @@unique([program_code, program_year])
  @@map("program")
}

model Faculty {
  id              Int        @id @default(autoincrement())
  university_id   Int
  name            String     @postgres.VarChar(100)
  name_th         String     @postgres.VarChar(100)
  abbreviation    String?    @postgres.VarChar(50)
  abbreviation_th String?    @postgres.VarChar(50)
  university      University @relation(fields: [university_id], references: [id], onDelete: Cascade)

  programs Program[]

  @@map("faculty")
}

model Course {
  id          Int               @id @default(autoincrement())
  code        String            @postgres.VarChar(50)
  name        String            @postgres.VarChar(255)
  name_th     String            @postgres.VarChar(255)
  program_id  Int
  section     Int
  semester    Int               @default(1)
  program     Program           @relation(fields: [program_id], references: [id], onDelete: Cascade)
  students    StudentOnCourse[]
  clo         Clo[]
  assignment Assignment[]
  score       StudentScore[]
  grade       GradeSetting[]


  @@map("course")
}

model Plo {
  id         Int     @id @default(autoincrement())
  code       String  @postgres.VarChar(50)
  program_id Int
  name       String
  engname    String
  program    Program @relation(fields: [program_id], references: [id], onDelete: Cascade)

  clo_plo_mappings CloPloMapping[]

  @@map("plo")
}

model Clo {
  id        Int    @id @default(autoincrement())
  code      String @postgres.VarChar(20)
  name      String @postgres.VarChar(255)
  name_th   String @postgres.VarChar(255)
  course_id Int
  course    Course @relation(fields: [course_id], references: [id], onUpdate: NoAction, onDelete: Cascade)

  clo_plo_mappings        CloPloMapping[]
  assignment_clo_mappings AssignmentCloMapping[]

  @@map("clo")
}

model CloPloMapping {
  id        Int      @id @default(autoincrement())
  cloId     Int      @map("clo_id")
  ploId     Int      @map("plo_id")
  weight    Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  clo Clo @relation(fields: [cloId], references: [id], onDelete: Cascade)
  plo Plo @relation(fields: [ploId], references: [id], onDelete: Cascade)

  @@unique([cloId, ploId], map: "unique_clo_plo")
  @@map("clo_plo_mapping")
}

model Assignment {
  id          Int         @id @default(autoincrement())
  courseId    Int         @map("course_id")
  name        String
  category    AssCategory @default(assignment) 
  description String?
  maxScore    Decimal     @default(100) @map("max_score")
  weight      Decimal     @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")

  course                  Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment_clo_mappings AssignmentCloMapping[]
  scores                  StudentScore[]

  @@map("assignment")
}

model Student {
  id         Int       @id @default(autoincrement())
  student_code String   @unique @postgres.VarChar(20)
  first_name String    @postgres.VarChar(100)
  last_name  String    @postgres.VarChar(100)
  program_id Int
  created_at DateTime? @default(now()) @postgres.Timestamp(6)
  program    Program?  @relation(fields: [program_id], references: [id], onUpdate: NoAction, onDelete: Cascade)

  courses StudentOnCourse[]
  scores  StudentScore[]

  @@map("student")
}

model StudentOnCourse {
  student_id Int
  course_id  Int
  assignedAt DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([student_id,course_id])
  @@map("student_on_course")
}

model AssignmentCloMapping {
  assId     Int      @map("assignment_id")
  cloId     Int      @map("clo_id")
  weight    Int?      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assId], references: [id], onDelete: Cascade)
  clo        Clo        @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([assId, cloId])
  @@map("assignment_clo_mapping")
}

model StudentScore {
  id            Int @id @default(autoincrement())
  student_id    Int
  assignment_id Int
  course_id     Int 
  score         Decimal @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  student    Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [course_id],references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@unique([student_id, assignment_id])
  @@map("student_score")
}

model GradeSetting {
  id            Int @id @default(autoincrement())
  grade         String
  score         Decimal @postgres.Decimal(5,2)
  course_id     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  course        Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("grade_setting")
}

enum AssCategory {
  quiz
  assignment
  project
  presentation
  midtermExam
  finalExam
}